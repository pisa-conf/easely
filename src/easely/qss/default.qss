QWidget {
    border: 0px solid red;
}

QLabel {
  font-family: "Comfortaa";
  color: black;
  font-size: 24px;
}

QTreeWidget {
  font-size: 24px;
}

QTreeWidget::item {
  font-size: 24px;
}

QHeaderView::section {
    font-size: 28px;
}

QLabel#title {
  font-size: 50px;
  margin-top: 16px;
  margin-bottom: 16px;
  margin-left: 0px;
}

QLabel#subtitle {
  font-size: 40px;
  margin-bottom: 40px;
  margin-left: 0px;
}

QLabel#presenter_name {
  font-size: 32px;
  margin-top: 0px;
  margin-bottom: 0px;
  min-width: 400px;
}

QLabel#presenter_affiliation {
  font-size: 30px;
  color: gray;
}

QLabel#status_message {
  font-size: 20px;
  margin-left: 40px;
}

QTableWidget#roster_table {
  font-size: 28px;
  min-height: 180px;
  margin-left: 40px;
}